<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device-transfer rules for Android 12 (API 31) and higher.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes

   Device identity is never backed up or transferred (rules.md §15): the node ID and the record
   of this install's Keystore identity key. Everything else keeps the default behaviour.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="disaster_connect_ble.xml" />
        <exclude domain="sharedpref" path="disaster_connect_identity.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="disaster_connect_ble.xml" />
        <exclude domain="sharedpref" path="disaster_connect_identity.xml" />
    </device-transfer>
</data-extraction-rules>
